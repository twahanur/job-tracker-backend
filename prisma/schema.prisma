datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// USER & AUTHENTICATION
// -------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  role             Role              @default(USER)
  candidateProfile CandidateProfile?
  cvs              CV[]
  jobs             Job[]
  companies        Company[]
  recruiters       Recruiter[]
  notifications    Notification[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([email])
}

model CandidateProfile {
  id                   String     @id @default(uuid())
  userId               String     @unique
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String?
  bio                  String?
  targetRoles          String[]
  skills               String[]
  preferredLocations   String[]
  workModePreferences  WorkMode[]
  minExpectedSalary    Decimal?   @db.Decimal(12, 2)
  targetSalary         Decimal?   @db.Decimal(12, 2)
  currency             String     @default("USD")
  noticePeriodDays     Int?       @default(30)
  portfolioUrl         String?
  linkedinUrl          String?
  githubUrl            String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

// -------------------------------------------------------------
// CV VAULT & VERSIONING
// -------------------------------------------------------------

model CV {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String           // e.g. "Fullstack Developer Resume - 2026"
  isPrimary      Boolean          @default(false)
  currentVersion Int              @default(1)
  versions       CvVersion[]
  matchResults   JobMatchResult[]
  applications   Application[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, isPrimary])
}

model CvVersion {
  id            String   @id @default(uuid())
  cvId          String
  cv            CV       @relation(fields: [cvId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileUrl       String   // Local or S3 path
  fileName      String
  fileSize      Int
  mimeType      String
  rawText       String   @db.Text
  parsedData    Json     // Structured JSON (skills, experience, education, projects, certs)
  summary       String?  @db.Text
  createdAt     DateTime @default(now())

  @@unique([cvId, versionNumber])
  @@index([cvId])
}

// -------------------------------------------------------------
// JOB INGESTION & MANAGEMENT
// -------------------------------------------------------------

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobSource {
  LINKEDIN
  INDEED
  GLASSDOOR
  COMPANY_WEBSITE
  MANUAL
  SCRAPED
}

enum IngestionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Job {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String?
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recruiterId        String?
  recruiter          Recruiter?      @relation(fields: [recruiterId], references: [id], onDelete: SetNull)

  title              String
  sourceUrl          String?
  sourcePlatform     JobSource       @default(MANUAL)
  rawContent         String?         @db.Text
  contentHash        String?         // SHA-256 for duplicate detection
  ingestionStatus    IngestionStatus @default(COMPLETED)

  // Extracted Metadata
  location           String?
  country            String?
  workMode           WorkMode        @default(REMOTE)
  jobType            JobType         @default(FULL_TIME)
  experienceRequired String?         // e.g. "3-5 years"
  minSalary          Decimal?        @db.Decimal(12, 2)
  maxSalary          Decimal?        @db.Decimal(12, 2)
  salaryCurrency     String          @default("USD")
  salaryPeriod       String          @default("YEARLY") // YEARLY, MONTHLY, HOURLY

  description        String          @db.Text
  responsibilities   String[]
  requirements       String[]
  requiredSkills     String[]
  preferredSkills    String[]
  benefits           String[]

  deadline           DateTime?
  postedAt           DateTime?
  isArchived         Boolean         @default(false)

  // Relations
  matchResults       JobMatchResult[]
  application        Application?
  notes              JobNote[]
  notifications      Notification[]

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId, isArchived, createdAt])
  @@index([userId, deadline])
  @@index([companyId])
  @@index([contentHash])
}

// -------------------------------------------------------------
// AI MATCHING ENGINE & ANALYTICS
// -------------------------------------------------------------

enum RecommendationTier {
  HIGHLY_RECOMMENDED // 85%+
  RECOMMENDED        // 70% - 84%
  MODERATE_MATCH     // 50% - 69%
  LOW_MATCH          // < 50%
}

model JobMatchResult {
  id              String             @id @default(uuid())
  jobId           String
  job             Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  cvId            String
  cv              CV                 @relation(fields: [cvId], references: [id], onDelete: Cascade)
  cvVersionNumber Int

  overallScore    Int                // 0 to 100
  recommendation  RecommendationTier

  // Breakdown Scores (0 - 100)
  skillsScore     Int
  experienceScore Int
  educationScore  Int
  locationScore   Int
  salaryScore     Int

  // Detailed Match Data
  matchedSkills   String[]
  missingSkills   String[]
  partialSkills   String[]
  strengths       String[]
  gaps            String[]
  actionableTips  String[]
  explanation     String             @db.Text

  createdAt       DateTime           @default(now())

  @@index([jobId, cvId])
  @@index([overallScore])
}

// -------------------------------------------------------------
// APPLICATION LIFECYCLE & OUTREACH
// -------------------------------------------------------------

enum ApplicationStatus {
  SAVED
  MATCHED
  DRAFTED
  APPLIED
  PHONE_SCREEN
  TECHNICAL_ASSESSMENT
  FIRST_ROUND_INTERVIEW
  FINAL_ROUND_INTERVIEW
  OFFER_RECEIVED
  OFFER_ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

model Application {
  id               String               @id @default(uuid())
  jobId            String               @unique
  job              Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  selectedCvId     String?
  selectedCv       CV?                  @relation(fields: [selectedCvId], references: [id], onDelete: SetNull)

  status           ApplicationStatus    @default(SAVED)
  appliedAt        DateTime?
  expectedSalary   Decimal?             @db.Decimal(12, 2)
  salaryCurrency   String               @default("USD")

  portalUrl        String?
  applicationNotes String?              @db.Text

  emails           EmailDraft[]
  followUps        FollowUpSchedule[]
  statusHistory    ApplicationHistory[]

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status])
}

model ApplicationHistory {
  id             String             @id @default(uuid())
  applicationId  String
  application    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  notes          String?
  changedAt      DateTime           @default(now())

  @@index([applicationId])
}

enum EmailType {
  COLD_APPLICATION
  FOLLOW_UP_1
  FOLLOW_UP_2
  THANK_YOU_POST_INTERVIEW
  OFFER_NEGOTIATION
  WITHDRAWAL
}

enum EmailStatus {
  DRAFT
  APPROVED
  SENT
}

model EmailDraft {
  id             String      @id @default(uuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           EmailType   @default(COLD_APPLICATION)
  recipientEmail String?
  recipientName  String?
  subject        String
  bodyMarkdown   String      @db.Text
  bodyHtml       String?     @db.Text
  status         EmailStatus @default(DRAFT)
  sentAt         DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([applicationId])
}

model FollowUpSchedule {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scheduledDate DateTime
  reminderTitle String
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, scheduledDate, isCompleted])
}

// -------------------------------------------------------------
// CRM: COMPANIES & RECRUITERS
// -------------------------------------------------------------

model Company {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  websiteUrl   String?
  domain       String?
  logoUrl      String?
  industry     String?
  companySize  String?     // e.g. "50-200 employees"
  headquarters String?
  notes        String?     @db.Text
  jobs         Job[]
  recruiters   Recruiter[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, name])
  @@index([userId, name])
}

model Recruiter {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name        String
  role        String?   // e.g. "Senior Technical Recruiter"
  email       String?
  phone       String?
  linkedinUrl String?
  notes       String?   @db.Text
  jobs        Job[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, companyId])
}

model JobNote {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
}

// -------------------------------------------------------------
// NOTIFICATION & AUTOMATION
// -------------------------------------------------------------

enum NotificationType {
  DEADLINE_APPROACHING
  FOLLOW_UP_DUE
  STALE_APPLICATION_WARNING
  MATCH_COMPLETED
  INGESTION_COMPLETED
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}
